[START_DESC_MSG]
1280 S "VCU 0x500 - TPS0: throttle%, tps0%, raw value, calib min/max";
1281 S "VCU 0x501 - TPS1: throttle%, tps1%, raw value, calib min/max";
1282 S "VCU 0x502 - BPS0: brake%, raw voltage, calib min/max";
1287 S "VCU 0x507 - LV battery voltage, regen torque, efficiency score, energy percentage (LV SOC byte unused — VCU bug)";
1298 S "VCU 0x512 - Power Limit Status B: PID integral, PL torque, target power, PID output, clamp method";
1536 S "Custom_BMS 0x600 - Safety Checker: fault/warning flags, cell imbalance, HV sense, and pack V (Sum + HVsens). Dashboard reads pack V from bytes 6-7.";
1569 S "Custom_BMS 0x621 - State of Charge: capacity (mAh), HV sense pack V, pack current (mA)";
1570 S "Custom_BMS 0x622 - Pack Summary 1: highest/lowest cell voltage (scale 0.0001 V), highest/lowest cell temp, total pack voltage. Dashboard reads cell temps from bytes 4-5.";
1571 S "Custom_BMS 0x623 - Pack Summary 2: fault/warning flags, pack imbalance, HV sense, pack SOC (future: drive left LEDs from bytes 6-7)";
165 S "Motor RPM (bytes 1-2)";
1697 S "Cumulative energy used in Wh, displayed as kWh";
[END_DESC_MSG]

[START_DESC_SIG]
[END_DESC_SIG]
[END_DESC]

