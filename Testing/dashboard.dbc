CM_ BO_ 1280 "Throttle Position Sensor 0 - percent and raw voltage";
CM_ BO_ 1281 "Throttle Position Sensor 1 - percent and raw voltage";
CM_ BO_ 1287 "LV battery voltage (bytes 0-1) and efficiency score (bytes 6-7)";
CM_ BO_ 1568 "HV current (bytes 0-3) and HV voltage (bytes 4-7)";
CM_ BO_ 1571 "Battery temperature pack (bytes 6-7)";
CM_ BO_ 0 "State of charge (bytes 6-7)";
CM_ BO_ 1 "BMS fault code (byte 1)";
CM_ BO_ 2 "BMS warning code (byte 1)";
CM_ BO_ 3 "BMS status (byte 6)";
CM_ BO_ 165 "Motor RPM (bytes 1-2, little-endian u16(d,2,1))";
CM_ BO_ 1697 "Cumulative energy used in Wh, displayed as kWh";

